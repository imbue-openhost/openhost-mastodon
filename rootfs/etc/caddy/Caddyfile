# Caddy front-door for the all-in-one Mastodon container.
#
# Listens on :8090 (behind the auth_proxy, which owns the public :8080
# that openhost.toml's `port` declares). The auth_proxy is a thin
# reverse proxy that adds OpenHost owner auto-login and otherwise hands
# every request straight to this Caddy. Splits traffic between the two
# upstream Mastodon processes:
#
#   /api/v1/streaming/*  →  127.0.0.1:4000  (node streaming, WebSockets)
#   everything else      →  127.0.0.1:3000  (puma web, REST + UI)
#
# Mastodon's CSRF + ActivityPub signature checks compare the inbound
# Host header against LOCAL_DOMAIN/WEB_DOMAIN. The OpenHost router
# strips the original Host on the way through and stuffs the public
# hostname into X-Forwarded-Host, so we rewrite Host back to that
# before forwarding to puma. Same trick the openhost-forgejo
# auth_proxy uses; mirrored here in Caddy syntax.
#
# We also bump proxy timeouts to match streaming's long-poll behaviour
# (default upstream WebSocket idle is generous but a default-Caddy
# install could time out a long-lived stream after 30s).
{
	# Disable automatic HTTPS — TLS terminates at the OpenHost router,
	# this Caddy is a plain-HTTP backend.
	auto_https off
	# Reduce Caddy's own admin API to localhost only (it's used for
	# config reloads, which we don't do).
	admin off
	# Trust the OpenHost router's X-Forwarded-* headers globally.
	# `servers` is a global-block-only directive — putting it inside a
	# site block fails caddyfile adapt with "unrecognized directive".
	# `client_ip_headers` populates {client_ip} from X-Forwarded-For so
	# logs reflect the real visitor IP rather than the OpenHost router's
	# container address. `trusted_proxies private_ranges` accepts any
	# RFC1918 / loopback / link-local source as a trusted forwarder —
	# the OpenHost router lives at a private podman bridge address so
	# this matches it.
	servers {
		client_ip_headers X-Forwarded-For
		trusted_proxies static private_ranges
	}
	# Quieter logs in production. Switch to DEBUG via env if needed.
	log {
		output stderr
		level INFO
		format console
	}
}

:8090 {
	# Set a virtual {forwarded_host} variable that prefers
	# X-Forwarded-Host (set by the OpenHost router) and falls back to
	# the inbound Host (covers local smoke tests and the rare router
	# liveness probe that doesn't bother stamping XFH). This makes
	# every header_up Host below point at *something* — Caddy v2's
	# placeholder evaluation collapses an absent header into literal
	# "", which Mastodon would then reject as Host mismatch / CSRF
	# failure / federation Signature mismatch (the inbound Signature
	# header from a remote ActivityPub server is computed against the
	# original Host).
	vars forwarded_host {http.request.header.X-Forwarded-Host}
	@no_xfh `{vars.forwarded_host} == ""`
	handle @no_xfh {
		vars forwarded_host {http.request.host}
	}

	# Streaming: long-lived WebSocket + SSE connections to the node
	# server. Order matters here — Caddy matches in the order written.
	@streaming path /api/v1/streaming /api/v1/streaming/*
	handle @streaming {
		reverse_proxy 127.0.0.1:4000 {
			# Override the upstream Host header to the public
			# hostname. Streaming itself doesn't enforce a Host
			# match (it's an API, not a CSRF-protected form),
			# but keeping things consistent helps debugging.
			header_up Host {vars.forwarded_host}
			# WebSocket connections idle long. 24h matches the
			# upstream nginx config that ships with Mastodon's
			# deployment guide.
			transport http {
				read_timeout 24h
				write_timeout 24h
				dial_timeout 5s
			}
		}
	}

	# Everything else → puma.
	#
	# `header_up Host` is the critical fix: without it, puma sees
	# `Host: 127.0.0.1:3000` and Rails' CSRF middleware refuses every
	# state-changing request with InvalidAuthenticityToken because the
	# computed origin doesn't match LOCAL_DOMAIN. We also use it for
	# inbound ActivityPub deliveries: a remote Mastodon instance signs
	# its delivery with its own private key over the request line +
	# (Host) header; if Caddy passes a different Host upstream than
	# what the remote server signed, our HTTP Signature verification
	# fails and the delivery is rejected with 401. Using
	# {vars.forwarded_host} (which falls back to the inbound Host
	# when X-Forwarded-Host is missing) keeps both flows working.
	#
	# `header_up X-Forwarded-Proto https` is hardcoded because the
	# OpenHost router only ever fronts public apps over TLS — the
	# request reaching this Caddy is always HTTPS-from-the-client
	# even though Caddy itself receives plain HTTP from the router.
	# Trying to pass through the inbound `X-Forwarded-Proto` ran into
	# a redirect loop on first deploy: when the header arrived empty
	# (which Caddy's placeholder evaluates to literal "") puma's
	# `force_ssl` middleware decided the request was HTTP, redirected
	# to HTTPS, and the client retried the same URL forever. Pinning
	# to "https" here side-steps the placeholder semantics entirely.
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {vars.forwarded_host}
			header_up X-Forwarded-Proto https
			# Fail fast on slow upstream — we'd rather return a
			# 502 to the OpenHost router so the front-door can
			# retry than tie up a Caddy worker indefinitely.
			transport http {
				read_timeout 5m
				write_timeout 5m
				dial_timeout 5s
			}
		}
	}
}
