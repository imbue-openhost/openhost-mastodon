#!/command/with-contenv bash
# auth-proxy longrun.
#
# The public front-door. Owns :8080 (the port openhost.toml declares to
# the OpenHost router) and reverse-proxies everything to Caddy on :8090.
# The only behaviour it adds is OpenHost owner auto-login: on an
# X-OpenHost-Is-Owner HTML navigation with no existing Mastodon session
# it calls the session-minter over $MINTER_SOCK and 302s the owner back
# with real Mastodon session cookies. Federation, public, anonymous and
# streaming traffic all pass straight through.
#
# Runs as the `mastodon` user so it can connect to the minter's UNIX
# socket (created 0600 by the mastodon-owned minter). It needs no DB or
# secrets access of its own — just Python.
#
# It has NO s6 dependencies on purpose, so it starts at the very
# beginning of stage 2 — BEFORE bootstrap runs db:migrate (which on a
# first boot takes minutes). This is what keeps the public :8080 port
# answering during the slow boot: the proxy serves the health path with
# a 200 "starting" placeholder until the Caddy/puma backend is up, so
# OpenHost's health check doesn't flag a still-booting instance as
# failed. Once the backend comes up, health and all other traffic proxy
# through normally. The proxy also degrades gracefully for owner SSO
# (owner sees the login form) if the session-minter socket isn't up yet.
set -eu

export AUTH_PROXY_PORT="${AUTH_PROXY_PORT:-8080}"
export CADDY_PORT="${CADDY_PORT:-8090}"
export MINTER_SOCK="${MINTER_SOCK:-/run/mastodon/minter.sock}"
export HEALTH_PATH="${HEALTH_PATH:-/health}"

exec s6-setuidgid mastodon env \
    AUTH_PROXY_PORT="$AUTH_PROXY_PORT" \
    CADDY_PORT="$CADDY_PORT" \
    MINTER_SOCK="$MINTER_SOCK" \
    HEALTH_PATH="$HEALTH_PATH" \
    /usr/bin/python3 /opt/openhost/auth_proxy.py
