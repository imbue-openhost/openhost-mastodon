#!/command/with-contenv bash
# Redis longrun service.
#
# We point Redis at $OPENHOST_APP_DATA_DIR/redis for RDB snapshots so
# Sidekiq's in-flight job queue survives container restarts. (Mastodon
# can rebuild the in-memory caches on its own; what matters is the
# delayed-job state.) Redis listens on 127.0.0.1 only — never exposed
# beyond the container.
set -eu

PERSIST="${OPENHOST_APP_DATA_DIR:-/data/app_data/mastodon}"
REDIS_DIR="$PERSIST/redis"

mkdir -p "$REDIS_DIR"
chown -R redis:redis "$REDIS_DIR"

# Use redis-server with explicit flags rather than /etc/redis/redis.conf
# so we don't have to template the Debian defaults file. Bind 127.0.0.1
# (Mastodon connects in-container), enable RDB persistence on the
# default save schedule, and put the pid under /run/redis (tmpfs).
mkdir -p /run/redis
chown redis:redis /run/redis

exec s6-setuidgid redis \
    /usr/bin/redis-server \
        --bind 127.0.0.1 \
        --port 6379 \
        --dir "$REDIS_DIR" \
        --dbfilename dump.rdb \
        --save "900 1" --save "300 10" --save "60 10000" \
        --pidfile /run/redis/redis-server.pid \
        --daemonize no \
        --supervised no \
        --logfile ""
